{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allegro",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "allegro-music" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "allegro",
    "database_id": "3f46bf51-561f-4d18-99b5-2008049334e9",
    "migrations_dir": "migrations"
  }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
